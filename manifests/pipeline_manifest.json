      ],
      "acceptance_artifacts": [
        "manifests/paper_release_provenance.json"
      ]
    },
    {
      "stage_id": "04b_finding1_rubric_as_response_capture",
      "title": "Finding 1 rubric-as-response capture check",
      "wrapper": "code/bin/04b_run_finding1_rubric_capture",
      "primary_inputs": [
