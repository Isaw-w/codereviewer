      "acceptance_artifacts": [
        "manifests/expected_metrics.json"
      ]
    },
    {
      "stage_id": "07_validation",
      "title": "Release validation",
      "wrapper": "code/bin/07_build_release_summaries",
      "primary_inputs": [
        "data/paper_release/",
        "data/canonical_full/",
        "code/validation/validate_release_closure.py",
        "code/validation/validate_release_metrics.py"
      ],
      "primary_scripts": [
        "code/validation/validate_release_closure.py",
        "code/validation/validate_release_metrics.py"
      ],
      "primary_outputs": [
        "manifests/expected_metrics.json",
        "manifests/validation/closure_report.json",
        "manifests/validation/metrics_report.json"
      ],
      "acceptance_artifacts": [
        "manifests/validation/closure_report.json",
        "manifests/validation/metrics_report.json"
      ]
    }
  ]
}
