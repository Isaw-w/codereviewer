      ],
      "primary_outputs": [
        "data/paper_release/rubrics/rewrite/",
        "data/paper_release/finding2/cascade_rescoring/"
      ],
      "notes": [
        "The first-pass generality judge can be rerun with the vendored script.",
        "The exact upstream cascade-consolidation step that produced the shipped final rewritten rubric is not vendored in this minimal closure."
      ],
      "acceptance_artifacts": [
        "manifests/paper_release_provenance.json"
      ]
    },
    {
      "stage_id": "06_finding3_coverage",
