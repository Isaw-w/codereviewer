        "code/build_global_unique_criteria.py",
        "code/build_pooled_unique_criteria.py",
        "code/build_top100_residuals.py",
        "code/run_find_only_dual_method.py"
      ],
      "primary_outputs": [
        "data/paper_release/finding3/coverage/",
        "data/paper_release/finding3/direct_check/",
        "data/paper_release/finding3/normative_tendencies/"
