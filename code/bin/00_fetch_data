#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
RELEASE_ROOT=$(cd "$SCRIPT_DIR/../.." && pwd)
DATA_DIR="$RELEASE_ROOT/data"

# Fetches the companion dataset from Hugging Face into ./data/, so the
# validation and pipeline scripts find their inputs at the expected
# release-relative paths.
#
# Required env var:
#   HF_DATASET_REPO   the dataset repo id, e.g. "anonymous/anon-rubric-release"
#
# Optional env var:
#   HF_REVISION       branch/tag/commit

DEFAULT_HF_REVISION="c165536f6b4393df4d71e3897bc5f1fb23f6e4b5"

: "${HF_DATASET_REPO:?Set HF_DATASET_REPO to the anonymous Hugging Face dataset repo id}"
HF_REVISION="${HF_REVISION:-$DEFAULT_HF_REVISION}"

if [[ -d "$DATA_DIR" ]] && [[ -n "$(ls -A "$DATA_DIR" 2>/dev/null)" ]]; then
  echo "data/ already populated at $DATA_DIR; remove it or pass --force to re-fetch" >&2
  if [[ "${1:-}" != "--force" ]]; then
    exit 0
  fi
  rm -rf "$DATA_DIR"
fi

if ! command -v huggingface-cli >/dev/null 2>&1; then
  echo "huggingface-cli not found. Install with: pip install -U huggingface_hub" >&2
  exit 1
fi

mkdir -p "$DATA_DIR"
huggingface-cli download \
  --repo-type dataset \
  --revision "$HF_REVISION" \
  --local-dir "$DATA_DIR" \
  --local-dir-use-symlinks False \
  "$HF_DATASET_REPO"

echo ""
echo "Fetched $HF_DATASET_REPO into $DATA_DIR"
echo "Run a fast sanity check:"
echo "  python3 code/validation/validate_release_metrics.py --section all"
