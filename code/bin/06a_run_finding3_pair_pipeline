#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
CODE_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
echo "Finding 3 note: the exact upstream pair-consolidation script is not vendored in this minimal closure."
echo "This wrapper validates the shipped authoritative pair artifact instead."
python3 "$CODE_DIR/validation/validate_release_metrics.py" --section finding3 "$@"
